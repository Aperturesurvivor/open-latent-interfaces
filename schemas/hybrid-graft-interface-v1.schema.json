{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-latent-interfaces.org/schemas/hybrid-graft-interface-v1.schema.json",
  "title": "Open Latent Interfaces Hybrid Graft Interface v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "model",
    "representation",
    "prompt_contract",
    "reader",
    "deterministic_mechanism",
    "writer",
    "evidence",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "oli.hybrid-graft-interface/v1"},
    "name": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residual_width"],
      "properties": {
        "residual_width": {"type": "integer", "minimum": 1}
      }
    },
    "prompt_contract": {
      "type": "object",
      "required": ["assistant_prefix", "locator", "output"]
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hidden_state_index", "manifest"],
      "properties": {
        "hidden_state_index": {"type": "integer", "minimum": 1},
        "manifest": {"$ref": "#/$defs/fileReference"}
      }
    },
    "deterministic_mechanism": {
      "type": "object",
      "required": ["type", "operation", "input_contract", "output_contract"]
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leading", "suffix"],
      "properties": {
        "leading": {
          "type": "object",
          "required": [
            "kind",
            "hidden_state_index",
            "desired_margin",
            "iterations",
            "norm_cap",
            "success_gate",
            "candidate_token_ids",
            "implementation"
          ]
        },
        "suffix": {
          "type": "object",
          "required": [
            "kind",
            "hidden_state_index",
            "rank",
            "scale",
            "norm_cap",
            "basis",
            "prototypes",
            "positions"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "audit_runs",
        "minimum_audit_exact_accuracy",
        "minimum_audit_reader_pair_accuracy",
        "dataset_config",
        "development_result",
        "development_correction",
        "audit_config",
        "audit_result"
      ]
    },
    "claim_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "key": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    }
  }
}
