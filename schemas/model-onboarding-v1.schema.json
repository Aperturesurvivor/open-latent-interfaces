{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-latent-interfaces.org/schemas/model-onboarding-v1.schema.json",
  "title": "Open Latent Interfaces Model Onboarding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "model",
    "task_contract",
    "compatibility",
    "evidence",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "oli.model-onboarding/v1"},
    "name": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_type",
            "architectures",
            "hidden_size",
            "num_hidden_layers",
            "vocab_size"
          ],
          "properties": {
            "model_type": {"type": "string", "minLength": 1},
            "architectures": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "hidden_size": {"type": "integer", "minimum": 1},
            "num_hidden_layers": {"type": "integer", "minimum": 4},
            "vocab_size": {"type": "integer", "minimum": 2}
          }
        }
      }
    },
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistant_prefix",
        "result_width",
        "probe_results",
        "probe"
      ],
      "properties": {
        "assistant_prefix": {"const": "Answer="},
        "result_width": {"type": "integer", "minimum": 1},
        "probe_results": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_prompt", "operand_a", "operand_b", "target"],
          "properties": {
            "user_prompt": {"type": "string", "minLength": 1},
            "operand_a": {"type": "integer", "minimum": 0},
            "operand_b": {"type": "integer", "minimum": 0},
            "target": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast_tokenizer_offsets",
        "chat_prefill",
        "single_token_decimal_digits",
        "compositional_fixed_width_results",
        "decoder_block_stack",
        "hidden_state_convention",
        "block_to_logits_gradient"
      ],
      "properties": {
        "fast_tokenizer_offsets": {"const": true},
        "chat_prefill": {"const": true},
        "single_token_decimal_digits": {"const": true},
        "compositional_fixed_width_results": {"const": true},
        "decoder_block_stack": {"const": true},
        "hidden_state_convention": {"const": true},
        "block_to_logits_gradient": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sources"],
      "properties": {
        "status": {
          "enum": ["audited_reference", "prospective_candidate"]
        },
        "sources": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/fileReference"}
        }
      }
    },
    "claim_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
