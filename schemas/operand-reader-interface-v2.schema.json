{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-latent-interfaces.org/schemas/operand-reader-interface-v2.schema.json",
  "title": "Open Latent Interfaces Operand Reader Interface v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "model",
    "representation",
    "locator",
    "reader",
    "evidence",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "oli.operand-reader-interface/v2"},
    "name": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residual_width"],
      "properties": {
        "residual_width": {"type": "integer", "minimum": 1}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract"],
      "properties": {
        "type": {"const": "external_semantic_operand_spans"},
        "contract": {"type": "string", "minLength": 1}
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hidden_state_index", "decision_rule", "tensors"],
      "properties": {
        "hidden_state_index": {"type": "integer", "minimum": 1},
        "decision_rule": {"type": "string", "minLength": 1},
        "tensors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "classes_key",
            "centroids_key",
            "counts_key"
          ],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "classes_key": {"type": "string", "minLength": 1},
            "centroids_key": {"type": "string", "minLength": 1},
            "counts_key": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader_audit_gate_passed",
        "audit_runs",
        "minimum_audit_pair_accuracy",
        "sources"
      ],
      "properties": {
        "reader_audit_gate_passed": {"const": true},
        "audit_runs": {"const": 1},
        "minimum_audit_pair_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "object",
          "required": [
            "selection_config",
            "selection_result",
            "audit_config",
            "audit_result"
          ],
          "additionalProperties": {"$ref": "#/$defs/fileReference"}
        }
      }
    },
    "claim_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
